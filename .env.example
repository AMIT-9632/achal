# Copy to .env and fill in. Never commit .env.
SITE_ID=jharia-demo
SCENARIO=normal            # normal | trough | pillar_collapse | faults | fire
SIM_SPEED=60               # simulated seconds per real second
SIM_SEED=42
SIM_PERIOD_S=              # sample period in s (default 60 from the site config); 600 for long troughs

# Simulated LoRa mesh (docs/mesh.md)
MESH_MODE=mesh             # mesh | star (single-hop baseline)
MESH_PROFILE=baseline      # baseline | harsh (denser clutter)
MESH_FAIL_FRACTION=0       # share of nodes that die without warning, e.g. 0.3
MESH_FAIL_AT_S=3600        # simulated seconds after start
MESH_FAIL_PATTERN=random   # random | cluster (a contiguous patch, e.g. a pothole)

# Gateway local siren rules, JSON overrides of services/gateway/src/rules.py Thresholds
GATEWAY_RULES=

# Backend: set to require "Authorization: Bearer <token>" for alert acknowledge
OPERATOR_TOKEN=

POSTGRES_USER=achal
POSTGRES_PASSWORD=change-me
POSTGRES_DB=achal

# Alerts (leave blank to log alerts to the console only)
RECIPIENTS_FILE=           # default config/recipients/<site>.example.yaml (fictional contacts)
SMS_PROVIDER=              # twilio | fast2sms | mock | console (default: whichever has credentials, else mock)
MOCK_SMS_OUTBOX=           # mock gateway outbox, default /data/sms-outbox.jsonl
FAST2SMS_API_KEY=
SMTP_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
