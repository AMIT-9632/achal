# Copy to .env and fill in. Never commit .env.
SITE_ID=jharia-demo
SCENARIO=normal            # normal | trough | pillar_collapse | faults | fire
SIM_SPEED=60               # simulated seconds per real second
SIM_SEED=42
SIM_PERIOD_S=              # sample period in s (default 60 from the site config); 600 for long troughs

POSTGRES_USER=achal
POSTGRES_PASSWORD=change-me
POSTGRES_DB=achal

# Alerts (leave blank to log alerts to the console only)
RECIPIENTS_FILE=           # default config/recipients/<site>.example.yaml (fictional contacts)
SMS_PROVIDER=              # twilio | fast2sms | console (default: whichever has credentials)
FAST2SMS_API_KEY=
SMTP_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
